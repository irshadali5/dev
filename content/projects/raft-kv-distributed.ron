ProjectMetadata(
    slug: "raft-kv-distributed",
    title: "Raft-KV: Fault-Tolerant Distributed Storage",
    description: "Distributed consensus-backed linearizable Key-Value store built on Tokio, gRPC (Tonic), dynamic cluster membership reconfiguration, and snapshot log compaction.",
    tags: ["Rust", "Distributed Systems", "Raft Consensus", "Tokio", "gRPC", "Linearizability", "Async"],
