    github_url: Some("https://github.com/irshadali5/raft-kv"),
    live_url: None,
    architecture: Some("Leader-follower state machine replication with quorum-based heartbeat election, pipelined log append RPCs, asynchronous snapshotting, and lease-based linearizable read leases."),
    benchmarks: Some("3-Node Quorum: 98,000 write ops/sec (p99 = 4.8ms); Linearizable Read Lease: 480,000 ops/sec (p99 = 0.65ms); Leader Failover Recovery < 320ms."),
    lessons_learned: Some("Linearizable reads without quorum roundtrips require rigorous clock drift analysis or monotonic read index exchange; leader leases must strictly respect bounded delta-times."),
)
