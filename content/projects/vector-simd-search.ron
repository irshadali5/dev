ProjectMetadata(
    slug: "vector-simd-search",
    title: "VectorSIMD: High-Dimensional Vector Search",
    description: "Concurrent in-memory vector database and approximate nearest neighbor (ANN) search engine implementing Hierarchical Navigable Small World (HNSW) graphs and AVX-512/NEON SIMD cosine metrics.",
    tags: ["Rust", "Vector Search", "HNSW", "SIMD", "AVX-512", "AI Infrastructure", "Algorithms"],
