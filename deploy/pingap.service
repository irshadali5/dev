[Unit]
Description=Pingap Reverse Proxy & TLS Gateway for irshadali.org
After=network.target dev-site.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/irshadali.org
ExecStart=/usr/local/bin/pingap -c /var/www/irshadali.org/pingap.toml
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
