# Database path (Stoolap embedded engine)
STOOLAP_DB_PATH=data/dev_site.stoolap

# JWT signing secret for /admin authentication
JWT_SECRET=change-me-to-a-long-random-secret

# Optional: automatically create an admin user on startup if not present
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Optional: deployment target (used by deploy_to_server.sh)
DOMAIN=example.com
IP_ADDRESSE=203.0.113.10
USER=ubuntu
KEY=~/.ssh/id_ed25519
